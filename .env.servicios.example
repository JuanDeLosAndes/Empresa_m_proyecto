MONGODB_URI=mongodb+srv://USUARIO_BD:CLAVE_CODIFICADA@TU_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=msps
MONGODB_TIMEOUT_MS=1500
MONGODB_REINTENTO_SEGUNDOS=15
MSPS_CACHE_CATALOGO_TTL=30

# Genera una clave fija aleatoria (no uses este texto como clave real).
MSPS_SECRET_KEY=REEMPLAZAR_POR_CLAVE_ALEATORIA_DE_AL_MENOS_32_CARACTERES
# Solo para Azure Linux; localmente se usa app/msps.db si omites esta variable.
# MSPS_DB_PATH=/home/data/msps.db

# Para pasar la base relacional de Azure a PostgreSQL, configura estas variables
# en App Service. El servidor debe permitir las IP de salida de la aplicación.
# MSPS_DB_ENGINE=postgresql
# PGHOST=TU_SERVIDOR.postgres.database.azure.com
# PGPORT=5432
# PGDATABASE=msps
# PGUSER=msps_app
# PGPASSWORD=CLAVE_DEL_USUARIO_POSTGRES
# PGSSLMODE=verify-full
# PGSSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
# MSPS_ADMIN_PASSWORD=CLAVE_INICIAL_DEL_ADMIN_DE_LA_WEB

# Usa el dominio real que aparece en Información general de tu App Service.
PUBLIC_BASE_URL=https://TU_DOMINIO_REAL.azurewebsites.net
WOMPI_AMBIENTE=test
WOMPI_PUBLIC_KEY=pub_test_REEMPLAZAR
WOMPI_PRIVATE_KEY=prv_test_REEMPLAZAR
WOMPI_INTEGRITY_SECRET=test_integrity_REEMPLAZAR
WOMPI_EVENTS_SECRET=test_events_REEMPLAZAR

# Para activar cobros reales, configura WOMPI_AMBIENTE=prod y sustituye las
# CUATRO llaves por sus valores de producción obtenidos en tu comercio aprobado.
# Webhook test: https://TU_DOMINIO_REAL/api/pagos/wompi/eventos/test
# Webhook prod: https://TU_DOMINIO_REAL/api/pagos/wompi/eventos/prod
